# Copy to .env and replace every placeholder before starting Docker Compose.
# Generate URL-safe random secrets, for example with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-64-character-hex-secret
REDIS_PASSWORD=replace-with-a-64-character-hex-secret
SESSION_SECRET=replace-with-a-different-64-character-hex-secret
DATABASE_URL=postgresql://shelfwise:localdevpassword@127.0.0.1:5432/shelfwise
REDIS_URL=redis://:localdevpassword@127.0.0.1:6379/0

# Exact origins only; use comma-separated HTTPS origins in production.
WEB_ORIGINS=http://localhost:3000
WEB_PORT=3000
NODE_ENV=development

# For production PostgreSQL with a private CA, provide the CA PEM here.
# Leave empty only for local development. Production API startup requires verified TLS.
DB_SSL_CA=
