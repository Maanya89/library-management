{
  "name": "@shelfwise/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').mkdirSync('dist/migrations',{recursive:true});require('node:fs').copyFileSync('src/migrations/001-initial.sql','dist/migrations/001-initial.sql')\"",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrate.ts",
    "create-staff": "tsx src/create-staff.ts"
  },
  "dependencies": {
    "@shelfwise/contracts": "1.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "pg": "^8.16.3",
    "rate-limit-redis": "^4.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.10",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6"
  }
}
